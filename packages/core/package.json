{
  "name": "@conovo/core",
  "version": "0.1.6",
  "description": "Conovo field taxonomy, expression engine, resolver, and validator \u2014 pure and deterministic",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JeanHules/easylegal.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "homepage": "https://www.conovo.co",
  "keywords": [
    "contracts",
    "documents",
    "esignature",
    "conovo"
  ],
  "dependencies": {
    "date-fns": "^4.1.0",
    "decimal.js": "^10.4.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
