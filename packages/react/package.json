{
  "name": "@conovo/react",
  "version": "0.1.29",
  "description": "Conovo embedded components \u2014 ContractStudio, SendContract, ContractInbox, StandingTerms. Themeable via --cv-* CSS variables.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conovo-co/conovo-js.git",
    "directory": "packages/react"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./styles.css": "./dist/styles.css"
    },
    "access": "public"
  },
  "homepage": "https://www.conovo.co",
  "keywords": [
    "contracts",
    "esignature",
    "react",
    "embedded",
    "conovo"
  ],
  "dependencies": {
    "@conovo/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
