{
  "name": "@conovo/node",
  "version": "0.1.1",
  "description": "Conovo server SDK \u2014 session token minting and webhook signature verification. The only place your secret key belongs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conovo-co/conovo-js.git",
    "directory": "packages/node"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "homepage": "https://www.conovo.co",
  "keywords": [
    "contracts",
    "esignature",
    "webhooks",
    "conovo"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
